generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  AUTHOR
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  firstName    String?
  lastName     String?
  role         UserRole @default(AUTHOR)
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PageStatus {
  DRAFT
  PUBLISHED
}

model Page {
  id             String     @id @default(uuid())
  title          String
  slug           String     @unique
  body           String?
  status         PageStatus @default(DRAFT)
  seoTitle       String?
  seoDescription String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
}

enum ServiceStatus {
  DRAFT
  PUBLISHED
}

model Service {
  id               String        @id @default(uuid())
  title            String
  slug             String        @unique
  shortDescription String?
  description      String?
  icon             String?
  coverImage       String?
  status           ServiceStatus @default(DRAFT)
  sortOrder        Int           @default(0)
  seoTitle         String?
  seoDescription   String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
}

model ProjectCategory {
  id   String @id @default(uuid())
  name String
  slug String @unique

  projects Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id               String        @id @default(uuid())
  title            String
  slug             String        @unique
  shortDescription String?
  description      String?
  clientName       String?
  location         String?
  projectDate      DateTime?
  coverImage       String?
  status           ProjectStatus @default(DRAFT)
  sortOrder        Int           @default(0)
  seoTitle         String?
  seoDescription   String?

  categoryId String?
  category   ProjectCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  images ProjectImage[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
}

model ProjectImage {
  id        String  @id @default(uuid())
  imageUrl  String
  altText   String?
  sortOrder Int     @default(0)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}