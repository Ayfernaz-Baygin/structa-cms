generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  AUTHOR
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  PUBLISH
  RESTORE
  LOGIN
}

model AuditLog {
  id         String      @id @default(uuid())
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     AuditAction
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime    @default(now())

  @@index([createdAt, id])
  @@index([action, createdAt])
  @@index([entityType, createdAt])
  @@index([userId])
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  firstName    String?
  lastName     String?
  role         UserRole @default(AUTHOR)
  isActive     Boolean  @default(true)

  posts         Post[]
  media         Media[]
  pageRevisions PageRevision[]
  auditLogs     AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PageStatus {
  DRAFT
  PUBLISHED
}

model Page {
  translations   PageTranslation[]
  id             String            @id @default(uuid())
  title          String
  slug           String
  body           String?
  status         PageStatus        @default(DRAFT)
  seoTitle       String?
  seoDescription String?

  sections    PageSection[]
  revisions   PageRevision[]
  homePageFor SiteSettings?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
}

// Snapshot of a Page (including its sections) taken right before an update
// or a restore, so every past state — including the one just replaced by a
// restore — stays recoverable. createdBy is SetNull (not Cascade) so the
// audit trail survives even if the acting user's account is later removed.
model PageRevision {
  translations   Json?
  id             String     @id @default(uuid())
  title          String
  slug           String
  body           String?
  status         PageStatus
  seoTitle       String?
  seoDescription String?
  sections       Json?

  pageId String
  page   Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([pageId])
}

enum SectionType {
  HERO
  TEXT
  IMAGE_TEXT
  SERVICES
  PROJECTS
  POSTS
  CTA
}

model PageSection {
  id        String      @id @default(uuid())
  type      SectionType
  sortOrder Int         @default(0)
  data      Json

  pageId String
  page   Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ServiceStatus {
  DRAFT
  PUBLISHED
}

model Service {
  translations     ServiceTranslation[]
  id               String               @id @default(uuid())
  title            String
  slug             String
  shortDescription String?
  description      String?
  icon             String?
  coverImage       String?
  status           ServiceStatus        @default(DRAFT)
  sortOrder        Int                  @default(0)
  seoTitle         String?
  seoDescription   String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
}

model ProjectCategory {
  id   String @id @default(uuid())
  name String
  slug String @unique

  projects Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  translations     ProjectTranslation[]
  id               String               @id @default(uuid())
  title            String
  slug             String
  shortDescription String?
  description      String?
  clientName       String?
  location         String?
  projectDate      DateTime?
  coverImage       String?
  status           ProjectStatus        @default(DRAFT)
  sortOrder        Int                  @default(0)
  seoTitle         String?
  seoDescription   String?

  categoryId String?
  category   ProjectCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  images ProjectImage[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
}

model ProjectImage {
  id        String  @id @default(uuid())
  imageUrl  String
  altText   String?
  sortOrder Int     @default(0)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// Shared by Post (and any future content type) — new table, so introducing this
// costs nothing; existing PageStatus/ServiceStatus/ProjectStatus columns are left
// untouched since renaming an in-use enum forces a destructive column rewrite.
enum ContentStatus {
  DRAFT
  PUBLISHED
}

model PostCategory {
  id   String @id @default(uuid())
  name String
  slug String @unique

  posts Post[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  translations   PostTranslation[]
  id             String            @id @default(uuid())
  title          String
  slug           String
  excerpt        String?
  content        String?
  coverImage     String?
  status         ContentStatus     @default(DRAFT)
  seoTitle       String?
  seoDescription String?

  categoryId String?
  category   PostCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
}

model Media {
  id           String  @id @default(uuid())
  originalName String
  fileName     String  @unique
  mimeType     String
  extension    String
  size         Int
  width        Int?
  height       Int?
  altText      String?
  title        String?
  path         String
  url          String

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Singleton row: the fixed literal id ("singleton") is upserted against, so
// there is always exactly one row and no separate uniqueness trick is needed.
model SiteSettings {
  id String @id @default("singleton")

  siteName          String?
  siteDescription   String?
  logoUrl           String?
  faviconUrl        String?
  email             String?
  phone             String?
  address           String?
  instagramUrl      String?
  facebookUrl       String?
  linkedinUrl       String?
  youtubeUrl        String?
  xUrl              String?
  footerText        String?
  googleMapsUrl     String?
  googleAnalyticsId String?

  // Optional CMS Page rendered at the public "/" route; onDelete: SetNull so
  // deleting that Page just falls back to the built-in homepage, never breaks Settings.
  homePageId String? @unique
  homePage   Page?   @relation(fields: [homePageId], references: [id], onDelete: SetNull)

  translations SiteSettingsTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum MenuLocation {
  HEADER
  FOOTER
}

enum MenuItemTarget {
  SELF
  BLANK
}

model Menu {
  id       String       @id @default(uuid())
  name     String
  location MenuLocation @unique

  items MenuItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MenuItem {
  id        String         @id @default(uuid())
  label     String
  url       String
  target    MenuItemTarget @default(SELF)
  sortOrder Int            @default(0)

  menuId String
  menu   Menu   @relation(fields: [menuId], references: [id], onDelete: Cascade)

  parentId String?
  parent   MenuItem?  @relation("MenuItemChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children MenuItem[] @relation("MenuItemChildren")

  translations MenuItemTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Locale {
  tr
  en
}

model PageTranslation {
  id             String  @id @default(uuid())
  pageId         String
  page           Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  locale         Locale
  title          String
  slug           String
  body           String?
  seoTitle       String?
  seoDescription String?

  @@unique([pageId, locale])
  @@unique([locale, slug])
}

model ServiceTranslation {
  id               String  @id @default(uuid())
  serviceId        String
  service          Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  locale           Locale
  title            String
  slug             String
  shortDescription String?
  description      String?
  seoTitle         String?
  seoDescription   String?

  @@unique([serviceId, locale])
  @@unique([locale, slug])
}

model ProjectTranslation {
  id               String  @id @default(uuid())
  projectId        String
  project          Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  locale           Locale
  title            String
  slug             String
  shortDescription String?
  description      String?
  seoTitle         String?
  seoDescription   String?

  @@unique([projectId, locale])
  @@unique([locale, slug])
}

model PostTranslation {
  id             String  @id @default(uuid())
  postId         String
  post           Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  locale         Locale
  title          String
  slug           String
  excerpt        String?
  content        String?
  seoTitle       String?
  seoDescription String?

  @@unique([postId, locale])
  @@unique([locale, slug])
}

model SiteSettingsTranslation {
  id              String       @id @default(uuid())
  siteSettingsId  String
  siteSettings    SiteSettings @relation(fields: [siteSettingsId], references: [id], onDelete: Cascade)
  locale          Locale
  siteName        String?
  siteDescription String?
  footerText      String?
  address         String?

  @@unique([siteSettingsId, locale])
}

model MenuItemTranslation {
  id         String   @id @default(uuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  locale     Locale
  label      String

  @@unique([menuItemId, locale])
}
