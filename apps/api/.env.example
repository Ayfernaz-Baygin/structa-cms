DATABASE_URL="postgresql://structa:change_me@localhost:5432/structa_cms?schema=public"

# Used to sign/verify JWT access tokens — use a long random string, never reuse across environments.
JWT_SECRET="change_me_to_a_long_random_string"

# Seed script (apps/api/prisma/seed.ts) upserts exactly one SUPER_ADMIN account from these values.
SEED_ADMIN_EMAIL="admin@structa.local"
SEED_ADMIN_PASSWORD="change_me"
