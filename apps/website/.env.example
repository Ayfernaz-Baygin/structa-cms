# Server-side base URL for the Structa API (not exposed to the browser).
API_URL=http://localhost:4000

# Public base URL for the Structa API — used to resolve media/image URLs
# (logo, cover images, gallery) in the browser. Not a secret.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Lets the Next.js Image Optimizer fetch media from a private/local IP (e.g. an
# API on localhost or an internal network) — otherwise Next's SSRF guard blocks
# it. Defaults to true outside production and false in production; only set
# this to true in production if the API is intentionally reached over a
# trusted private network.
ALLOW_LOCAL_MEDIA_IP=false
